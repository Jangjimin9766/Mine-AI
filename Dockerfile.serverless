# RunPod Serverless Dockerfile for M:ine AI
# Lightweight version - model downloads at runtime (faster build, slower cold start)

FROM runpod/pytorch:2.1.0-py3.10-cuda11.8.0-devel-ubuntu22.04

WORKDIR /app

ARG GIT_COMMIT=unknown

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# RunPod may schedule workers on Blackwell GPUs (sm_120). The base image's
# PyTorch 2.1/CUDA 11.8 build does not include kernels for that architecture,
# so install a CUDA 12.8 PyTorch wheel with Blackwell support.
RUN pip install --no-cache-dir --upgrade torch==2.7.1 --index-url https://download.pytorch.org/whl/cu128

# Install RunPod SDK
RUN pip install runpod

# Copy application code
COPY . .

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV GIT_COMMIT=$GIT_COMMIT

# Run the handler
CMD ["python", "-u", "handler.py"]
