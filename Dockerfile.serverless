# RunPod Serverless Dockerfile for M:ine AI
# Model weights are cached on the RunPod network volume when it is mounted.

FROM runpod/pytorch:2.1.0-py3.10-cuda11.8.0-devel-ubuntu22.04

WORKDIR /app

ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip uninstall -y torch torchvision torchaudio triton \
    && pip install --no-cache-dir torch==2.7.1 --index-url https://download.pytorch.org/whl/cu128 \
    && pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV GIT_COMMIT=$GIT_COMMIT
ENV BUILD_DATE=$BUILD_DATE
ENV HF_HOME=/runpod-volume/huggingface
ENV HF_HUB_CACHE=/runpod-volume/huggingface/hub
ENV TRANSFORMERS_CACHE=/runpod-volume/huggingface/transformers
ENV DIFFUSERS_CACHE=/runpod-volume/huggingface/diffusers

# Run the handler
CMD ["python", "-u", "handler.py"]
